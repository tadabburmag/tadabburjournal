<main class="tadabbur-page" dir="ltr">
  <section class="tadabbur-hero">
    <div class="tadabbur-container">
      <p class="tadabbur-kicker">Tadabbur Journal</p>
      <h1>Statistics Dashboard</h1>
      <p class="tadabbur-lead">A concise view of journal indicators with a documented source and update date for every metric.</p>
    </div>
  </section>

  <section class="tadabbur-section">
    <div class="tadabbur-container tadabbur-grid">
      <article class="tadabbur-card"><h2 data-stat="publications">0</h2><p>Publications</p></article>
      <article class="tadabbur-card"><h2 data-stat="countries">0</h2><p>Countries</p></article>
      <article class="tadabbur-card"><h2 data-stat="views">0</h2><p>Views</p></article>
    </div>
  </section>

  <section class="tadabbur-section">
    <div class="tadabbur-container tadabbur-card">
      <h2>Data provenance</h2>
      <p>Document the source and last update date for every metric. Do not publish unverified numbers.</p>
    </div>
  </section>
</main>